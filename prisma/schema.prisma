// Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for authentication

enum Role {
  player
  admin
}
model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  player_id String    @unique
  name      String
  email     String    @unique
  profile_img String?
  phone     String?
  whatsapp  String?
   upiId   String?
  Gpay    String?
  password  String
  role      Role    @default(player)                  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  stats     UserStats?
  matches   Match[]
  rooms     Room[]
  bookings  Booking[]
}

// User statistics
model UserStats {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalMatches Int    @default(0)
  totalPrice Int      @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Match details
model Match {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kills     Int       @default(0)
  deaths    Int       @default(0)
  assists   Int       @default(0)
  damage    Int       @default(0)
  placement Int?
  duration  Int?      // in seconds
  mapName   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

// Room/Tournament data
model Room {
  id        Int       @id @default(autoincrement())
  roomName  String
  createdBy Int
  creator   User      @relation(fields: [createdBy], references: [id])
  map_img String?
  maxPlayers Int      @default(10)
  currentPlayers Int  @default(0)
  status    String    @default("waiting") // "waiting", "active", "completed"
  total_price Int  @default(0)
  entry_fee Int    @default(0)
  match_type String
  startTime DateTime?
  endTime   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bookings Booking[]

  @@index([createdBy])
}

// Seat Bookings for Rooms
model Booking {
  id          Int      @id @default(autoincrement())
  
  roomId      Int
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  
  seatNumber  Int
  playerId    String   @default("")
  status      String   @default("confirmed")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([roomId, seatNumber])
  @@unique([roomId, playerId], name: "roomId_playerId_unique")
  @@index([roomId])
  @@index([userId])
}
