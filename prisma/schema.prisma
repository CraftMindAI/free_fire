// Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for authentication

enum Role {
  player
  admin
}
model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  player_id String    @unique
  email     String    @unique
  profile_img String?
  phone     String?
  whatsapp  String?
  password  String
  role      Role    @default(player)                  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  // stats     UserStats?
  rooms     Room[]
  bookings  Booking[]
  payments  Payment[]
}




// Room/Tournament data
model Room {
  id        Int       @id @default(autoincrement())
  roomName  String
  createdBy Int
  creator   User      @relation(fields: [createdBy], references: [id])
  map_img String?
  maxPlayers Int      @default(10)
  currentPlayers Int  @default(0)
  status    String    @default("waiting") // "waiting", "active", "completed"
  total_price Int  @default(0)
  entry_fee Int    @default(0)
  total_price_genrated Int  @default(0)
  match_type String
  startTime DateTime?
  endTime   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  bookings Booking[]
  payments Payment[]

  @@index([createdBy])
}

// Seat Bookings for Rooms
model Booking {
  id          Int      @id @default(autoincrement())

  roomId       Int
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId       Int
  user         User     @relation(fields: [userId], references: [id])

  seatNumber   Int

  playerId     String
  playerName   String?
  email        String?

  phone         String?
  whatsapp      String?
  upiId         String?
  Gpay          String?

  status        String   @default("confirmed")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([roomId, seatNumber])
  @@unique([roomId, playerId])
  @@index([roomId])
  @@index([userId])
}

// Payment history and distribution
model Payment {
  id                 Int      @id @default(autoincrement())
  userId             Int
  user               User     @relation(fields: [userId], references: [id])
  roomId             Int
  room               Room     @relation(fields: [roomId], references: [id])
  amount             Int
  prizeAmount        Int      @default(0)
  status             String   @default("paid")
  distributionStatus String   @default("pending")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([roomId])
}

// Contact Messages
model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  mobile    String
  message   String
  createdAt DateTime @default(now())
}
